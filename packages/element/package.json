{
  "name": "tacet-element",
  "version": "0.1.0",
  "description": "Веб-компонент <tacet-icon>: набор иконок Tacet без React.",
  "license": "MIT",
  "author": "Ilya Smurov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilyasmurov/tacet.git",
    "directory": "packages/element"
  },
  "homepage": "https://tacet.smurov.com",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "tacet-core": "workspace:^"
  },
  "keywords": [
    "icons",
    "svg",
    "web-components",
    "custom-elements",
    "icon-set"
  ],
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.2.8",
    "tacet-react": "workspace:^"
  }
}
