{
  "name": "tacet-native",
  "version": "0.1.1",
  "description": "Tacet icons for React Native — the same set, drawn with react-native-svg",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "svg-path-properties": "^1.3.0",
    "tacet-core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72",
    "react-native-svg": ">=14"
  },
  "keywords": [
    "icons",
    "react-native",
    "svg",
    "tacet"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilyasmurov/tacet.git",
    "directory": "packages/native"
  },
  "author": "Ilya Smurov",
  "homepage": "https://tacet.smurov.com",
  "sideEffects": false,
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-native": "^0.87.0",
    "react-native-svg": "^15.15.5"
  }
}
