{
  "name": "tacet-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "typecheck": "pnpm -r --filter './packages/*' typecheck",
    "test": "vitest run",
    "svg": "pnpm build && node scripts/build-svg.ts",
    "meta": "pnpm build && node scripts/build-meta.ts meta",
    "gallery": "pnpm build && node scripts/build-gallery.ts gallery.html",
    "deploy": "./scripts/deploy-site.sh"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
